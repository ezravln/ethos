{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Verify EthOS VGA build",
			"type": "shell",
			"command": "make",
			"args": [
				"-B"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Build EthOS ISO",
			"type": "shell",
			"command": "./scripts/build.sh",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Smoke test EthOS VGA",
			"type": "shell",
			"command": "timeout",
			"args": [
				"8s",
				"qemu-system-x86_64",
				"-M",
				"q35",
				"-m",
				"512M",
				"-cdrom",
				"build/ethos.iso",
				"-boot",
				"d",
				"-serial",
				"stdio",
				"-display",
				"none",
				"-monitor",
				"none",
				"-no-reboot",
				"-no-shutdown"
			],
			"problemMatcher": []
		},
		{
			"label": "Capture EthOS serial boot",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"timeout 10s qemu-system-x86_64 -M q35 -m 512M -cdrom build/ethos.iso -boot d -serial file:/tmp/ethos-serial-final.log -display none -monitor none -no-reboot -no-shutdown; cat /tmp/ethos-serial-final.log"
			],
			"problemMatcher": []
		},
		{
			"label": "Inspect QEMU VGA state",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"rm -f /tmp/ethos-qemu.sock; qemu-system-x86_64 -M q35 -m 512M -cdrom build/ethos.iso -boot d -serial file:/tmp/ethos-inspect-serial.log -display none -monitor unix:/tmp/ethos-qemu.sock,server,nowait -no-reboot -no-shutdown -daemonize; printf 'info vga\\nxp /16hx 0xb8000\\nquit\\n' | socat - UNIX-CONNECT:/tmp/ethos-qemu.sock; cat /tmp/ethos-inspect-serial.log"
			],
			"problemMatcher": []
		},
		{
			"label": "Read VGA mode register state",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"printf 'info vga\\n' | socat -t 2 - UNIX-CONNECT:/tmp/ethos-qemu.sock; printf '\\n-- VGA memory --\\n'; printf 'xp /16hx 0xb8000\\n' | socat -t 2 - UNIX-CONNECT:/tmp/ethos-qemu.sock; printf '\\n-- serial --\\n'; cat /tmp/ethos-inspect-serial.log"
			],
			"problemMatcher": []
		},
		{
			"label": "Check QEMU monitor process",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"ps -ef | grep '[q]emu-system-x86_64'; ls -l /tmp/ethos-qemu.sock /tmp/ethos-inspect-serial.log; cat /tmp/ethos-inspect-serial.log"
			],
			"problemMatcher": []
		},
		{
			"label": "Query active VGA memory",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"printf 'xp /16hx 0xb8000\\n' | socat -T 1 - UNIX-CONNECT:/tmp/ethos-qemu.sock"
			],
			"problemMatcher": []
		},
		{
			"label": "Restart QEMU VGA inspection",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"kill 96755 2>/dev/null || true; rm -f /tmp/ethos-qmp.sock /tmp/ethos-qmp-serial.log; qemu-system-x86_64 -M q35 -m 512M -cdrom build/ethos.iso -boot d -serial file:/tmp/ethos-qmp-serial.log -display none -qmp unix:/tmp/ethos-qmp.sock,server,nowait -no-reboot -no-shutdown -daemonize; ls -l /tmp/ethos-qmp.sock"
			],
			"problemMatcher": []
		},
		{
			"label": "Read VGA through QMP",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"printf '{\"execute\":\"qmp_capabilities\"}\\r\\n{\"execute\":\"human-monitor-command\",\"arguments\":{\"command-line\":\"info vga\"}}\\r\\n{\"execute\":\"human-monitor-command\",\"arguments\":{\"command-line\":\"xp /16hx 0xb8000\"}}\\r\\n{\"execute\":\"quit\"}\\r\\n' | socat -T 2 - UNIX-CONNECT:/tmp/ethos-qmp.sock"
			],
			"problemMatcher": []
		},
